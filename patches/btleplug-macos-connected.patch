+    async fn retrieve_connected_peripherals(
+        &mut self,
+        service_uuids: &[Uuid],
+        fut: CoreBluetoothReplyStateShared,
+    ) {
+        let service_uuids = service_uuids
+            .iter()
+            .copied()
+            .map(uuid_to_cbuuid)
+            .collect::<Vec<_>>();
+        let service_refs = service_uuids.iter().map(Deref::deref).collect::<Vec<_>>();
+        let services = NSArray::from_slice(&service_refs);
+        let peripherals = unsafe {
+            self.manager
+                .retrieveConnectedPeripheralsWithServices(&services)
+        };
+        let mut identifiers = Vec::with_capacity(peripherals.len());
+        for peripheral in peripherals {
+            unsafe {
+                peripheral.setDelegate(Some(ProtocolObject::from_ref(&*self.delegate)));
+            }
+            let identifier = unsafe { peripheral.identifier() };
+            identifiers.push(nsuuid_to_uuid(&identifier));
+            self.on_discovered_peripheral(peripheral, None).await;
+        }
+        fut.lock()
+            .unwrap()
+            .set_reply(CoreBluetoothReply::PeripheralsRetrieved(identifiers));
