@@ -98,6 +98,38 @@ impl Adapter {
             sender: adapter_sender,
         })
     }
+
+    /// Retrieves peripherals already connected to macOS that expose all requested services.
+    pub async fn connected_peripherals_with_services(
+        &self,
+        service_uuids: &[uuid::Uuid],
+    ) -> Result<Vec<Peripheral>> {
+        let future = CoreBluetoothReplyFuture::default();
+        self.sender
+            .to_owned()
+            .send(CoreBluetoothMessage::RetrieveConnectedPeripherals {
+                service_uuids: service_uuids.to_vec(),
+                future: future.get_state_clone(),
+            })
+            .await?;
+        let CoreBluetoothReply::PeripheralsRetrieved(identifiers) = future.await else {
+            return Err(Error::UnexpectedCallback);
+        };
+        let mut peripherals = Vec::with_capacity(identifiers.len());
+        for identifier in identifiers {
+            let id = PeripheralId::from(identifier);
+            let mut retrieved = None;
+            for _ in 0..100 {
+                if let Ok(peripheral) = self.peripheral(&id).await {
+                    retrieved = Some(peripheral);
+                    break;
+                }
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            }
+            peripherals.push(retrieved.ok_or(Error::DeviceNotFound)?);
+        }
+        Ok(peripherals)
+    }
 }

