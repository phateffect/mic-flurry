{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://micflurry.local/schema/control-api-v1.json",
  "title": "MicFlurry local JSON-RPC v1 frame",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/notification" }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": {
          "enum": [
            "v1.status",
            "v1.settings",
            "v1.set_settings",
            "v1.refresh_devices",
            "v1.connect",
            "v1.release",
            "v1.start_recording",
            "v1.stop_recording",
            "v1.start_hid_capture",
            "v1.stop_hid_capture",
            "v1.reload_keymap"
          ]
        },
        "params": {}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ],
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "v1.event" },
        "params": {
          "type": "object",
          "required": ["type"]
        }
      },
      "additionalProperties": false
    }
  }
}
