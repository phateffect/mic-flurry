<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.phateffect.MicFlurry.hid-probe</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MicFlurry/MicFlurry HID Probe.app/Contents/MacOS/micflurry-hid-probe</string>
        <string>--duration</string>
        <string>30</string>
    </array>
    <key>StandardErrorPath</key>
    <string>/var/tmp/micflurry-hid-probe.err.log</string>
    <key>StandardOutPath</key>
    <string>/var/tmp/micflurry-hid-probe.out.log</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
